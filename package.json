{
  "name": "chatgpt-switch",
  "description": "在本机保存、管理和快速切换多个 ChatGPT 登录状态的浏览器扩展。",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:edge": "wxt zip --browser edge",
    "zip:firefox": "wxt zip --browser firefox",
    "release:build": "bun run zip:chrome && bun run zip:edge && bun run zip:firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test && bun run build",
    "postinstall": "wxt prepare",
    "test:e2e": "bun run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:native": "bun run build && playwright test native-popup.spec.ts"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@wxt-dev/module-react": "1.2.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wxt": "0.21.4"
  }
}
